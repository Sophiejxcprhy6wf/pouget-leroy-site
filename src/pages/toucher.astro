---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articlesByRubrique } from '../data/articles';

const items = articlesByRubrique('toucher');
---

<Layout title="Toucher — Sophie Pouget-Leroy" description="Cas cliniques, observations terrain, ce que les mains savent avant le mot.">

  <div class="article-header" style="background:#ccd4c2;">
    <div class="rub-bar" style="background:#8a9e84; height:2px; width:28px; margin-bottom:22px;"></div>
    <p class="article-header-rub">02</p>
    <h1 class="article-header-title">Toucher</h1>
    <p class="article-header-date">Cas cliniques, observations terrain, ce que les mains savent avant le mot.</p>
  </div>

  <hr class="line">

  <main class="articles-zone">
    {items.map((article) => <ArticleCard article={article} label="date" />)}
  </main>

</Layout>
