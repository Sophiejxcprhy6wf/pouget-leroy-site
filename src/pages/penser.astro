---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articlesByRubrique } from '../data/articles';

const items = articlesByRubrique('penser');
---

<Layout title="Penser — Sophie Pouget-Leroy" description="Essais, prises de position épistémiques, ce qui résiste à la simplification.">

  <div class="article-header" style="background:#e0cfc6;">
    <div class="rub-bar" style="background:#b89a8c; height:2px; width:28px; margin-bottom:22px;"></div>
    <p class="article-header-rub">01</p>
    <h1 class="article-header-title">Penser</h1>
    <p class="article-header-date">Essais, prises de position épistémiques, ce qui résiste à la simplification.</p>
  </div>

  <hr class="line">

  <main class="articles-zone">
    {items.map((article) => <ArticleCard article={article} label="date" />)}
  </main>

</Layout>
