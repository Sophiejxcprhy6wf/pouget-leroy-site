---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { latestArticles } from '../data/articles';

const items = latestArticles(4);
---

<Layout
  title="Sophie Pouget-Leroy — Ostéopathe animalier, formatrice, penseuse"
  description="Ostéopathe animalier et technicien dentaire équin, Sophie Pouget-Leroy partage ses réflexions sur la pratique, le corps et la transmission. Écrits de terrain sur pouget-leroy.fr"
  canonical="https://pouget-leroy.fr"
>

  <div class="hero">
    <div class="hero-text">
      <div>
        <h1 class="hero-title">Ostéopathe.<br>Formatrice.<br>Penseuse.</h1>
        <p class="hero-meta">Écrits de terrain — pouget-leroy.fr</p>
      </div>
    </div>
    <div class="hero-photo">
      <img src="/Via ferrata evolene jpeg.jpg" alt="Sophie Pouget-Leroy sur la via ferrata d'Evolène" style="width:100%; height:100%; object-fit:cover; object-position:center center; display:block;">
    </div>
  </div>

  <hr class="line">

  <div class="rubriques">
    <a href="/penser" class="rubrique rub-penser">
      <div class="rub-bar"></div>
      <div class="rub-num">01</div>
      <h2 class="rub-title">Penser</h2>
      <p class="rub-desc">Essais, prises de position épistémiques, ce qui résiste à la simplification.</p>
    </a>
    <a href="/toucher" class="rubrique rub-toucher">
      <div class="rub-bar"></div>
      <div class="rub-num">02</div>
      <h2 class="rub-title">Toucher</h2>
      <p class="rub-desc">Cas cliniques, observations terrain, ce que les mains savent avant le mot.</p>
    </a>
    <a href="/resonances" class="rubrique rub-resonances">
      <div class="rub-bar"></div>
      <div class="rub-num">03</div>
      <h2 class="rub-title">Résonances</h2>
      <p class="rub-desc">Sources extérieures qui traversent, jazz, lecture, rencontres inattendues.</p>
    </a>
  </div>

  <hr class="line">

  <main class="articles-zone">
    <p class="section-label">Derniers écrits</p>

    {items.map((article) => <ArticleCard article={article} label="rubrique" />)}
  </main>

</Layout>
