---
import type { Article } from '../data/articles';

interface Props {
  article: Article;
  label: 'rubrique' | 'date'; // homepage affiche la rubrique, une page de rubrique affiche la date
}

const { article, label } = Astro.props;
---

<a href={`/articles/${article.slug}`} class="article-card">
  <div class={`article-img img-${article.rubriqueClass}`} style={article.icon ? 'padding:20px;' : undefined}>
    {article.icon ? (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#3a3835" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
      </svg>
    ) : (
      <img
        src={article.image}
        alt={article.alt}
        style={`width:100%; height:100%; object-fit:cover; object-position:${article.objectPosition ?? 'center'}; display:block;${article.imageOpacity ? ` opacity:${article.imageOpacity};` : ''}`}
      />
    )}
  </div>
  <div>
    <p class="art-rub">{label === 'rubrique' ? article.rubrique : article.dateLabel}</p>
    <h2 class="art-title">{article.title}</h2>
    <p class="art-excerpt">{article.excerpt}</p>
  </div>
</a>
